[user]
    name  = Egor Kuznetsov
    email = ek2kkk@yandex.ru

[core]
    compression  = 9
    preloadindex = true
    editor       = nvim
    autocrlf     = input
    pager        = delta

[filter "lfs"]
    clean   = git-lfs clean -- %f
    smudge  = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[push]
    default = simple

[pull]
    rebase = false

[init]
    defaultBranch = main

[color]
    ui = auto

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram

[interactive]
    diffFilter = delta --color-only --features=interactive

[delta]
    line-numbers = true
    side-by-side = false
    features     = decorations
    syntax-theme = ansi

[delta "interactive"]
    keep-plus-minus-markers = true

[delta "decorations"]
    commit-decoration-style      = blue ol
    commit-style                 = raw
    file-style                   = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style       = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style            = file line-number syntax

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    lg = log --graph --oneline --decorate --all
